<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DSD.Toolkit.WPF.UI">


    <FontFamily x:Key="IconFontFamily">pack://application:,,,/DSD.Toolkit.WPF.UI;component/assets/#iconfont</FontFamily>


    <Style TargetType="{x:Type local:IconSymbol}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:IconSymbol}">
                    <TextBlock
                        HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalAlignment}"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="{TemplateBinding FontSize}"
                        Foreground="{TemplateBinding Foreground}"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                        Text="{TemplateBinding Icon}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



</ResourceDictionary>